// Armor Flashlight (goodmod.armorflashlight): настройки, которых нет в окне игры.
// Вид подсветки (цветовая схема, заливка, непрозрачность, режим) -- в «Настройки -> Прицел -> Подсветка брони».
// Мод файл не перезаписывает; чтобы вернуть значения по умолчанию, удалите его -- он создастся заново.
// Клавиши, настройки подсветки и её включение действуют со следующего боя; ускоритель, инспектор и весь мод -- после
// перезапуска клиента. Клавиши: "Y", "ALT+Y", "CTRL+SHIFT+Y", "U" и т. п., пустая строка "" -- без клавиши.
// Не назначайте клавиши игры: клиент выполняет свою команду при любых модификаторах (F4 -- «Назад на базу!»).
{
    // служебная версия файла настроек: мод сам поднимает её при обновлении (сохраняя ваши значения). Не редактируйте.
    "configVersion": 1,
    // false -- мод не загружается совсем (ни подсветка в бою, ни инспектор в ангаре)
    "enabled": true,
    // подробный журнал в python.log (сборка данных по машинам, состав боя и т. п.)
    "debugLog": false,
    // при первом запуске мод сам создаёт папки данных в res_mods; клиент видит их только после перезапуска.
    // "auto" -- перезапустить клиент сам один раз (с защитой от зацикливания); "ask" -- спросить в ангаре
    // диалогом; "off" -- ничего, только сообщение «перезапустите клиент». Перезапуск делается ровно один раз.
    "firstRunRestart": "auto",

    // подсветка брони в бою
    "flashlight": {
        "enabled": true,
        // C++-ускоритель сборки данных (работает, если установлен wot.common); без него та же сборка на Python
        "nativeAccelerator": true,
        // лучи выстрела из дула к каждой точке, как в EU; false -- параллельно направлению прицела
        "shotFromMuzzle": true,
        // цвет поверх навесных деталей цели (ящики, крылья, запасные траки); false -- только где видна броня
        "overTargetDetails": true,
        "hotkeys": {
            "toggle": "Y",              // включить / выключить
            "scheme": "ALT+Y",          // цветовая схема
            "pattern": "CTRL+Y",        // заливка
            "opacity": "CTRL+SHIFT+Y",  // непрозрачность
            "mode": "U",                // режим: обычный / экономичный / полный / для слабых ПК (эконом + малый круг EU)
            "shotRays": "SHIFT+U",      // лучи из дула / параллельно прицелу
            "overDetails": "CTRL+U",    // поверх деталей / только броня
            "allies": "",               // союзники тоже цели (для проверки в тренировочной комнате)
            "circle": "X"               // удерживать: круг размера EU (плавно), отпустить -- обычный размер
        }
    },

    // инспектор брони в ангаре
    "inspector": {
        "enabled": true,
        "hotkeys": {
            "mode": "ALT+I",            // выкл -> номинальная броня -> шанс пробития
            "shell": "ALT+K"            // следующий снаряд атакующего орудия
        }
    }
}
